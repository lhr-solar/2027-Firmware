{
  "name": "canspec-viewer",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build-site": "tsc -b && vite build",
    "export-data": "python3 export_canspec_json.py -o canspec-data.json",
    "export-data:dist": "python3 export_canspec_json.py -o dist/canspec-data.json",
    "build": "npm run build-site && npm run export-data:dist",
    "preview": "vite preview",
    "preview:local": "npm run build && vite preview --host 127.0.0.1 --port 4173"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react-swc": "^3.8.0",
    "typescript": "~5.7.0",
    "vite": "^6.2.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
