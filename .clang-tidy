---
Checks: >
  -*,
  clang-analyzer-*,
  -clang-analyzer-core.FixedAddressDereference,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  cert-*,
  -cert-dcl37-c,
  -cert-dcl51-cpp,
  cppcoreguidelines-*,
  -cppcoreguidelines-avoid-non-const-global-variables,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-narrowing-conversions,
  -cppcoreguidelines-macro-to-enum,
  misc-definitions-in-headers,
  misc-misleading-indentation,
  misc-redundant-expression,
  modernize-*,
  performance-*,
  -performance-no-int-to-ptr,
  readability-*,
  -readability-redundant-declaration,
  -readability-braces-around-statements

CheckOptions:
  bugprone-reserved-identifier.AllowedIdentifiers: '^_(close|execve|exit|fork|fstat|getpid|isatty|kill|link|lseek|open|read|sbrk|stat|times|unlink|wait|write|end|estack|Min_Stack_Size|[HCDAM]FSR|MMAR|BFAR)$;^__(env|io_getchar|io_putchar|sbrk_heap_end|weak)$'
  # don't charge a function for branches hidden inside macro expansions
  readability-function-cognitive-complexity.IgnoreMacros: true

# reported, but don't fail the build
WarningsAsErrors: '*,-readability-magic-numbers,-readability-identifier-length,-readability-function-cognitive-complexity,-modernize-macro-to-enum,bugprone-macro-parentheses'

HeaderFilterRegex: '.*/firmware/.*'
ExcludeHeaderFilterRegex: '.*/firmware/platform/(stm|middleware|common)/.*|.*/(stm32g4xx_hal_conf|FreeRTOSConfig)\.h'
SystemHeaders: false
FormatStyle: file
...
